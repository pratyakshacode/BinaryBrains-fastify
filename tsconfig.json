{
  "include": ["src/**/*"],
  "compilerOptions": {
  
     "lib": [
        "es2021",
        "es5",
        "es6",
     ],
     "target": "es6",
     "module": "commonjs",
     "moduleResolution": "node",
     "outDir": "dist",
     "rootDir": "src",
     "emitDecoratorMetadata": true,
     "experimentalDecorators": true,
     "esModuleInterop": true,
     "sourceMap": true,
     "skipLibCheck": true,
     "allowJs": true,
     "types": ["node"],
     "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "exclude": ["node_modules", "external"]
}