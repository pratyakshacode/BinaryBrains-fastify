{
  "include": ["src/**/*"],
  "compilerOptions": {
     "lib": ["es2022"],              // Fastify runs on modern Node, so you can use modern features
     "target": "es2022",             // Compiles to modern JS supported by current Node versions
     "module": "Node16",             // Matches modern Node's module system
     "moduleResolution": "Node16",   // The fix for your deprecation warning
     "outDir": "dist",
     "rootDir": "src",
     "emitDecoratorMetadata": true,
     "experimentalDecorators": true,
     "esModuleInterop": true,
     "sourceMap": true,
     "skipLibCheck": true,
     "allowJs": true,
     "types": ["node"],
     "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "exclude": ["node_modules", "dist"]
}